# Root environment file consumed by docker-compose.yml. Copy to `.env`.
POSTGRES_USER=azeroth
POSTGRES_PASSWORD=azeroth
POSTGRES_DB=azeroth_flip
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=3000
WEB_PORT=5173

# Blizzard API credentials passed to the api container (leave empty for SAMPLE mode)
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=us
BLIZZARD_LOCALE=en_GB
TARGET_EXPANSION_NAME=Classic Forever
AUCTION_REFRESH_INTERVAL_MINUTES=0
