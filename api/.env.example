# ---------------------------------------------------------------------------
# Azeroth Flip API configuration. Copy to `api/.env` and fill in your values.
# NEVER commit real credentials. `.env` is git-ignored.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://azeroth:azeroth@localhost:5432/azeroth_flip?schema=public

# HTTP port for the REST API
PORT=3000
# Comma-separated list of allowed browser origins (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# Blizzard Battle.net API client (create one at https://develop.battle.net/access/clients)
# Leave empty to run in explicitly-labeled SAMPLE mode.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Region to analyze (EU only for now: eu | us | kr | tw are supported by the client)
BLIZZARD_REGION=eu
BLIZZARD_LOCALE=en_GB

# Expansion whose profession skill tiers are imported (matched against the skill tier name)
TARGET_EXPANSION_NAME=Midnight

# Blizzard API throttling (Blizzard allows ~100 req/s and 36,000 req/hour per client)
BLIZZARD_MAX_CONCURRENCY=8
BLIZZARD_MAX_REQUESTS_PER_SECOND=50
BLIZZARD_MAX_RETRIES=4

# Auction House commission deducted from sales (5% = 0.05)
AH_CUT_RATE=0.05

# Automatic EU commodity refresh interval in minutes (0 = disabled; Blizzard updates hourly)
AUCTION_REFRESH_INTERVAL_MINUTES=0

# Optional Redis for future BullMQ scheduled jobs (not required for the MVP)
REDIS_URL=redis://localhost:6379
